# ============================================================
# AQUABOT - Git Ignore
# ============================================================

# Ambiente virtual
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.class
*.pyo

# Testes / cobertura
.pytest_cache/
.coverage
htmlcov/

# Variáveis de ambiente e segredos
.env
.env.*
!.env.example

# Bancos locais
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# IDEs
.vscode/
.idea/

# Sistema operacional
.DS_Store
Thumbs.db

# Temporários
*.tmp
*.temp

# Build / distribuição
build/
dist/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Arquivos temporários de IA
.ai_temp/
